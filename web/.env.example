# Vercel의 Settings → Environment Variables에 같은 이름으로 넣습니다. 이 파일에는 진짜 값을 적지 마세요.
DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
TEACHER_PASSWORD=선생님이_쓸_비밀번호
SESSION_SECRET=32자_이상의_아무_문자열
# 문제 만들기 (Streamlit Secrets에 있는 값과 같음)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   (비우면 자동으로 최신 Flash)
